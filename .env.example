# Zoho OAuth Configuration
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8080/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://sprintsapi.zoho.in/zsapi
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=

# Optional Zoho Context Defaults (useful if working on a single team/project/sprint)
ZOHO_TEAM_ID=
ZOHO_PROJECT_ID=
ZOHO_SPRINT_ID=
ZOHO_DEFAULT_ITEM_TYPE_ID=
ZOHO_DEFAULT_PRIORITY_ID=

# AI Provider Configuration (OpenAI or OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Application Settings
LOG_LEVEL=INFO
